{
  "name": "@goodit/evals",
  "version": "0.8.1",
  "description": "Pragmatic eval framework for LLM features. Runs eval files as Bun tests with scorers, baselines, and reporting.",
  "keywords": [
    "ai",
    "baseline",
    "bun",
    "evals",
    "llm",
    "scorers",
    "testing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neoromantic/evals.git"
  },
  "bin": {
    "goodit-evals": "bin/goodit-evals"
  },
  "files": [
    "bin",
    "src/*.ts",
    "!src/*.test.ts",
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./preload": {
      "types": "./dist/src/preload.d.ts",
      "bun": "./src/preload.ts",
      "import": "./dist/src/preload.js",
      "default": "./dist/src/preload.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.json && bun scripts/fix-dist-imports.ts",
    "eval": "bun src/run.ts",
    "eval:select": "bun src/run.ts select",
    "eval:update": "UPDATE_BASELINE=1 bun src/run.ts",
    "test": "bun test src/*.test.ts scripts/*.test.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run check:knip",
    "check:knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "prepack": "bun run build",
    "release": "bun scripts/release.ts",
    "release:dry-run": "bun scripts/release.ts --dry-run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "ink": "^6.8.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@interfere/landmines": "0.1.0",
    "@types/bun": "^1.3.10",
    "@types/react": "^19.2.14",
    "ai": "^6.0.116",
    "autoevals": "^0.0.132",
    "knip": "6.45.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "ai": ">=6",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "packageManager": "bun@1.4.2"
}
