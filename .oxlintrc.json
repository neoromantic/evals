{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.devkit.jsonc"],
  "rules": {
    "landmines-style/no-comments": [
      "error",
      { "publicApi": ["/src/index\\.ts$", "/src/preload\\.ts$"] }
    ],
    "landmines-testing/no-flake-masking": ["error", { "allow": { "src/eval-suite.ts": 1 } }]
  }
}
